cabal-version: 3.0
name:          postgres-template-db
version:       0.1.0.0
synopsis:      Throwaway PostgreSQL test databases cloned from a migrated template
description:
  Starts one throwaway PostgreSQL cluster, runs your migrations once into a
  template database, and gives each test its own clone made with
  @CREATE DATABASE ... TEMPLATE@: tens of milliseconds per test instead of an
  @initdb@ and a full migration. Clones may be created and dropped
  concurrently. Needs @initdb@ and @pg_ctl@ on the @PATH@.
license:       BSD-3-Clause
license-file:  LICENSE
author:        Brian Raszap, Jordan Myska Allen
maintainer:    https://github.com/UptrustHQ/postgres-template-db/issues
copyright:     2025-2026 UpTrust
homepage:      https://github.com/UptrustHQ/postgres-template-db
bug-reports:   https://github.com/UptrustHQ/postgres-template-db/issues
category:      Database, Testing
build-type:    Simple
tested-with:   GHC ==9.10.3
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/UptrustHQ/postgres-template-db.git

common shared
  default-language: Haskell2010
  default-extensions:
    ImportQualifiedPost
    TypeApplications
  ghc-options: -Wall -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Database.PostgreSQL.TemplateDb
  build-depends:
    , base               >=4.18  && <5
    , bytestring         >=0.11  && <0.13
    , directory          >=1.3   && <1.4
    , filepath           >=1.4   && <1.6
    , postgresql-simple  >=0.6.5 && <0.8
    , process            >=1.6   && <1.7
    , temporary          >=1.3   && <1.4

test-suite postgres-template-db-tests
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , async
    , bytestring
    , base
    , postgres-template-db
    , postgresql-simple
    , tasty
    , tasty-hunit
